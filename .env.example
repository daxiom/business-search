# BC Registries Search API Configuration
# Get credentials from https://developer.api.bcregistry.gov.bc.ca/

# BC Registries API Key (Header: x-apikey)
BC_REGISTRY_API_KEY=

# BC Registries Account ID (Header: Account-Id)
BC_REGISTRY_ACCOUNT_ID=

# Base URL for the BC Registries API gateway
# Sandbox: https://sandbox.api.connect.gov.bc.ca
# Production: https://api.connect.gov.bc.ca
BC_REGISTRY_BASE_URL=https://sandbox.api.connect.gov.bc.ca
